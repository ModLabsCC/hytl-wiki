{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
      },
      "labels": {
        "type": "object",
        "propertyNames": {
          "type": "string",
          "minLength": 2,
          "maxLength": 35,
          "pattern": "^[a-z]{2,3}(?:-[a-z0-9]{2,8})*$"
        },
        "additionalProperties": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "description": {
        "type": "object",
        "propertyNames": {
          "type": "string",
          "minLength": 2,
          "maxLength": 35,
          "pattern": "^[a-z]{2,3}(?:-[a-z0-9]{2,8})*$"
        },
        "additionalProperties": {
          "type": "string",
          "maxLength": 1000
        }
      }
    },
    "required": [
      "id",
      "labels"
    ],
    "additionalProperties": false
  }
}
