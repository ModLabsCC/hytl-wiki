{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "defaultLocale": {
      "type": "string",
      "minLength": 2,
      "maxLength": 35,
      "pattern": "^[a-z]{2,3}(?:-[a-z0-9]{2,8})*$"
    },
    "locales": {
      "minItems": 1,
      "maxItems": 30,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 35,
        "pattern": "^[a-z]{2,3}(?:-[a-z0-9]{2,8})*$"
      }
    }
  },
  "required": [
    "schemaVersion",
    "defaultLocale",
    "locales"
  ],
  "additionalProperties": false
}
