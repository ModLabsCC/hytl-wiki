{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "hytlMarkdown": {
      "type": "number",
      "const": 1
    },
    "locale": {
      "type": "string",
      "minLength": 2,
      "maxLength": 35,
      "pattern": "^[a-z]{2,3}(?:-[a-z0-9]{2,8})*$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "slug": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "status": {
      "type": "string",
      "enum": [
        "stub",
        "outdated",
        "work-in-progress",
        "complete"
      ]
    },
    "aliases": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240
      }
    },
    "sourceLocale": {
      "type": "string",
      "minLength": 2,
      "maxLength": 35,
      "pattern": "^[a-z]{2,3}(?:-[a-z0-9]{2,8})*$"
    },
    "sourceRevision": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sources": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "maxLength": 2048
          },
          "revision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "license": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "retrievedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "attribution": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "modifications": {
            "type": "string",
            "maxLength": 4000
          },
          "authorsUrl": {
            "type": "string",
            "maxLength": 2048
          }
        },
        "required": [
          "url",
          "revision",
          "license",
          "retrievedAt",
          "attribution"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "hytlMarkdown",
    "locale",
    "title",
    "slug",
    "description",
    "status"
  ],
  "additionalProperties": false
}
