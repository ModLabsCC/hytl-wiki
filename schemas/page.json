{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "sourceLocale": {
      "type": "string",
      "minLength": 2,
      "maxLength": 35,
      "pattern": "^[a-z]{2,3}(?:-[a-z0-9]{2,8})*$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "guide",
        "mechanic",
        "item",
        "entity",
        "zone",
        "concept",
        "reference",
        "hub"
      ]
    },
    "categories": {
      "maxItems": 30,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
      }
    },
    "tags": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
      }
    },
    "relations": {
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "item",
              "entity",
              "zone",
              "wiki",
              "site-page",
              "asset"
            ]
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "role": {
            "type": "string",
            "enum": [
              "primary",
              "guide",
              "related",
              "mention",
              "embed"
            ]
          }
        },
        "required": [
          "kind",
          "id",
          "role"
        ],
        "additionalProperties": false
      }
    },
    "sources": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "maxLength": 2048
          },
          "revision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "license": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "retrievedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "attribution": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "modifications": {
            "type": "string",
            "maxLength": 4000
          },
          "authorsUrl": {
            "type": "string",
            "maxLength": 2048
          }
        },
        "required": [
          "url",
          "revision",
          "license",
          "retrievedAt",
          "attribution"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "sourceLocale",
    "kind",
    "categories",
    "tags",
    "relations"
  ],
  "additionalProperties": false
}
